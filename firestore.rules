rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Granted only through a trusted Firebase Admin SDK operation.
    function admin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    // phone/defaultAddress may be empty until the customer saves delivery details.
    // defaultAddress is a string, and a non-empty phone uses international format.
    function validProfile(data, uid) {
      return data.keys().hasAll([
          'uid', 'name', 'email', 'phone', 'defaultAddress', 'role',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'name', 'email', 'phone', 'defaultAddress', 'role',
          'createdAt', 'updatedAt'
        ])
        && data.uid == uid
        && data.name is string
        && data.name.size() >= 1 && data.name.size() <= 100
        && data.email is string
        && data.email.size() >= 1 && data.email.size() <= 254
        && data.phone is string
        && (data.phone == '' || data.phone.matches('[+][1-9][0-9]{7,14}'))
        && data.defaultAddress is string
        && data.defaultAddress.size() <= 500
        && data.role in ['customer', 'admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validCartItem(productId) {
      let data = request.resource.data;
      let product = get(/databases/$(database)/documents/products/$(productId)).data;
      return data.keys().hasAll(['productId', 'quantity', 'updatedAt'])
        && data.keys().hasOnly(['productId', 'quantity', 'updatedAt'])
        && data.productId == productId
        && data.quantity is int
        && data.quantity >= 1
        && product.isActive == true
        && product.stockQuantity is int
        && data.quantity <= product.stockQuantity
        && data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if owner(uid);
      allow list: if false;

      // Only a baseline customer profile can be created by the client.
      allow create: if owner(uid)
        && validProfile(request.resource.data, uid)
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.role == 'customer'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if owner(uid)
        && validProfile(request.resource.data, uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phone', 'defaultAddress', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      // Account deletion and identity/role changes need trusted backend cleanup.
      allow delete: if false;

      match /cart/{productId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && validCartItem(productId);
        allow delete: if owner(uid);
      }

      match /checkoutAttempts/{attemptId} {
        allow get: if owner(uid);
        allow list, write: if false;
      }
    }

    match /categories/{categoryId} {
      allow read: if admin() || resource.data.isActive == true;
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if admin() || resource.data.isActive == true;
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if admin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      // Creation, cancellation and status changes run in trusted transactions.
      allow write: if false;
    }

    // Includes emailChallenges, emailRateLimits, emailOutbox and unknown paths.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
